name: Pinterest Login

on:
  workflow_dispatch:
    inputs:
      action:
        description: 'Action to perform'
        required: false
        default: 'login'
        type: choice
        options:
          - login
          - screenshot

jobs:
  pinterest:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Playwright
        run: |
          npm install playwright
          npx playwright install chromium --with-deps

      - name: Login to Pinterest
        env:
          PIN_EMAIL: ${{ secrets.PIN_EMAIL }}
          PIN_PASSWORD: ${{ secrets.PIN_PASSWORD }}
        run: node .github/scripts/pinterest.js

      - name: Upload screenshot
        uses: actions/upload-artifact@v4
        with:
          name: pinterest-screenshot
          path: pinterest-*.png
          retention-days: 3
