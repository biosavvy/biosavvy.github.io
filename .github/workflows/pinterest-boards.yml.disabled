name: Pinterest Create Boards

on:
  workflow_dispatch:

jobs:
  boards:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Playwright
        run: |
          npm install playwright
          npx playwright install chromium --with-deps

      - name: Create Boards
        env:
          PIN_EMAIL: ${{ secrets.PIN_EMAIL }}
          PIN_PASSWORD: ${{ secrets.PIN_PASSWORD }}
        run: node .github/scripts/pinterest-boards.js

      - name: Upload screenshots
        uses: actions/upload-artifact@v4
        with:
          name: pinterest-boards
          path: pinterest-*.png
          retention-days: 3
